{
  "crons": [
    {
      "path": "/api/cron/reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/trainer-follow?type=reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/trainer-follow?type=no-input",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/trainer-follow?type=stalled",
      "schedule": "0 0 * * 1"
    }
  ]
}
